{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lossless saved Ableton document",
  "description": "A saved ALS payload with a derived, non-editable review tree. Separate from the MCP snapshot schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schema_version", "captured_at", "source", "state"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "ableton-native-document" },
    "schema_version": { "const": "0.1.0" },
    "captured_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "gzip_base64"],
      "properties": {
        "file_name": { "type": "string", "pattern": "^[^/\\\\]+\\.als$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gzip_base64": { "type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "session", "tracks", "return_tracks", "master_track", "file_references"],
      "properties": {
        "creator": { "type": "string" },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tempo", "signature_numerator", "signature_denominator"],
          "properties": {
            "tempo": { "type": "number", "exclusiveMinimum": 0 },
            "signature_numerator": { "type": "integer", "minimum": 1, "maximum": 99 },
            "signature_denominator": { "type": "integer", "enum": [1, 2, 4, 8, 16] }
          }
        },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "return_tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "master_track": { "$ref": "#/$defs/track" },
        "file_references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "relative_path", "pack"],
            "properties": {
              "path": { "type": "string" },
              "relative_path": { "type": "string" },
              "pack": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "type", "name", "devices", "mixer_values", "clip_slots", "arrangement_clips"],
      "properties": {
        "index": { "type": "integer" },
        "id": { "type": ["string", "null"] },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
        "mixer_values": { "$ref": "#/$defs/values" },
        "clip_slots": { "type": "array", "items": { "type": "object" } },
        "arrangement_clips": { "type": "array", "items": { "type": "object" } }
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": { "path": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "type", "name", "parameter_values", "macros", "chains", "return_chains"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "parameter_values": { "$ref": "#/$defs/values" },
        "macros": { "type": "array", "items": { "type": "object" } },
        "chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } },
        "return_chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "mixer_values", "devices"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "mixer_values": { "$ref": "#/$defs/values" },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } }
      }
    }
  }
}
